<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.12</Version>
    <AssemblyVersion>1.0.12.0</AssemblyVersion>
    <FileVersion>1.0.12.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GovDocFormatter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GovDocFormatter\FormattingOptions.cs" Link="FormattingOptions.cs" />
    <Compile Include="..\GovDocFormatter\GovDocumentFormatter.cs" Link="GovDocumentFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
